{
  "name": "@narcisbodea/smstunnel-sdk",
  "version": "2.1.1",
  "description": "SMSTunnel SDK - send texts from your own software through your own Android phone and number. QR pairing, sending and E2E encryption for Node.js, NestJS, React, Vue and Angular",
  "keywords": [
    "smstunnel",
    "sms",
    "android-sms",
    "send-sms-from-computer",
    "sms-sync",
    "own-number",
    "notifications",
    "qr-pairing",
    "e2e-encryption",
    "nestjs",
    "react",
    "vue",
    "angular"
  ],
  "author": "NARBOWEB SRL",
  "license": "MIT",
  "homepage": "https://smstunnel.io/docs/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/narcisbodea/smstunnel-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/narcisbodea/smstunnel-sdk/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.mjs",
      "require": "./dist/server/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.mjs",
      "require": "./dist/react/index.js"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "import": "./dist/vue/index.mjs",
      "require": "./dist/vue/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.mjs",
      "require": "./dist/node/index.js"
    },
    "./angular": {
      "types": "./dist/angular/index.d.ts",
      "import": "./dist/angular/index.mjs",
      "require": "./dist/angular/index.js"
    }
  },
  "bin": {
    "smstunnel-make-certificate": "dist/cli/make-certificate.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "dependencies": {
    "qrcode-generator": "^1.4.4"
  },
  "peerDependencies": {
    "@angular/common": ">=17.0.0",
    "@angular/core": ">=17.0.0",
    "@nestjs/common": ">=10.0.0",
    "@nestjs/core": ">=10.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "rxjs": ">=7.0.0",
    "vue": ">=3.3.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    },
    "@nestjs/core": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "@angular/core": {
      "optional": true
    },
    "@angular/common": {
      "optional": true
    },
    "rxjs": {
      "optional": true
    }
  },
  "devDependencies": {
    "@angular/common": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@nestjs/common": "^11.1.17",
    "@nestjs/core": "^11.1.17",
    "@types/node": "^20.19.43",
    "@types/react": "^18.0.0",
    "react": "^18.0.0",
    "rxjs": "^7.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vue": "^3.5.0"
  }
}
